---
import { site } from '@data/site';
import { Icon } from 'astro-icon/components';

const education = site.education;
const awards = site.awards;
---

<section
  id="education"
  class="mb-24 scroll-mt-24 lg:mb-32 lg:scroll-mt-8"
  aria-labelledby="education-heading"
>
  <h2 id="education-heading" class="section-heading">Education</h2>

  <ol class="space-y-10">
    {education.map((item) => (
      <li class="edu-node flex gap-4">
        <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-full border border-accent/40 bg-white-soft text-accent">
          <Icon name="ph:graduation-cap" class="h-4 w-4" />
        </span>
        <div class="min-w-0">
          <p class="font-mono text-xs uppercase tracking-wider text-accent">{item.period}</p>
          <h3 class="mt-1 text-lg font-semibold text-slate">{item.degree}</h3>
          <p class="mt-0.5 text-sm text-slate-light">
            <a href={item.institutionUrl} class="subtle-link" target="_blank" rel="noreferrer">
              {item.institution}
            </a>
            <span class="text-slate-lightest"> · {item.location}</span>
          </p>

          {'thesis' in item && item.thesis && (
            <div class="mt-4 rounded-md border-l-2 border-accent bg-white-soft py-3 pl-4 pr-3">
              <span class="text-[0.65rem] font-semibold uppercase tracking-[0.18em] text-accent">
                {item.thesis.label}
              </span>
              <p class="mt-1 text-sm italic leading-relaxed text-slate">&ldquo;{item.thesis.title}&rdquo;</p>
              {item.thesis.link && (
                <a
                  href={item.thesis.link}
                  class="subtle-link mt-2 inline-flex items-center gap-1 text-xs"
                  target="_blank"
                  rel="noreferrer"
                >
                  Read <Icon name="ph:arrow-up-right" class="h-3 w-3" />
                </a>
              )}
            </div>
          )}

          {'highlights' in item && item.highlights && (
            <ul class="mt-3 list-disc space-y-1 pl-5 text-sm text-slate">
              {item.highlights.map((h) => (
                <li>{h}</li>
              ))}
            </ul>
          )}
        </div>
      </li>
    ))}
  </ol>

  <div class="mt-14">
    <h3 class="mb-5 flex items-center gap-2 text-sm font-semibold uppercase tracking-[0.18em] text-slate-light">
      <Icon name="ph:trophy" class="h-4 w-4 text-accent" /> Honors &amp; Awards
    </h3>
    <div class="grid gap-4 sm:grid-cols-2">
      {awards.map((a) => (
        <div class="edu-node panel-card flex gap-3">
          <Icon name="ph:medal" class="mt-0.5 h-5 w-5 shrink-0 text-accent" />
          <div>
            <p class="font-semibold text-slate">
              {a.name} <span class="font-mono text-xs text-accent">· {a.year}</span>
            </p>
            <p class="text-xs uppercase tracking-wider text-slate-lightest">{a.awarder}</p>
            <p class="mt-1 text-sm text-slate-light">{a.note}</p>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .edu-node {
    opacity: 0;
    transform: translateY(20px);
    transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .edu-node.reveal {
    opacity: 1;
    transform: translateY(0);
  }
</style>

<script>
  function revealEdu() {
    const nodes = document.querySelectorAll('.edu-node');

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const index = Array.from(nodes).indexOf(entry.target);
            setTimeout(() => entry.target.classList.add('reveal'), (index % 3) * 120);
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15, rootMargin: '0px 0px -10px 0px' }
    );

    nodes.forEach((node) => observer.observe(node));
  }

  revealEdu();
  document.addEventListener('astro:after-swap', revealEdu);
</script>
