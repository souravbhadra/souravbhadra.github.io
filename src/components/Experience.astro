---
import { site } from '../../data/site';
import { Icon } from 'astro-icon/components';

type Segment = { type: 'text'; value: string } | { type: 'link'; value: string; href: string };

function parseHighlight(text: string): Segment[] {
  const segments: Segment[] = [];
  const pattern = /\[([^\]]+)\]\(([^)]+)\)/g;
  let lastIndex = 0;
  for (const match of text.matchAll(pattern)) {
    const start = match.index ?? 0;
    if (start > lastIndex) segments.push({ type: 'text', value: text.slice(lastIndex, start) });
    segments.push({ type: 'link', value: match[1], href: match[2] });
    lastIndex = start + match[0].length;
  }
  if (lastIndex < text.length) segments.push({ type: 'text', value: text.slice(lastIndex) });
  return segments;
}
---

<section id="experience" class="mb-24 scroll-mt-24 lg:mb-32 lg:scroll-mt-8" aria-labelledby="experience-heading">
  <h2 id="experience-heading" class="section-heading">Experience</h2>
  <div class="space-y-3">
    {site.experiences.map((item, i) => (
      <article class="scroll-stat panel-card overflow-hidden">
        <button
          class="accordion-trigger w-full flex items-center gap-3 text-left cursor-pointer"
          aria-expanded="false"
          aria-controls={`exp-body-${i}`}
        >
          <a
            href={item.companyUrl}
            target="_blank"
            rel="noreferrer"
            class="logo-slot w-10 h-10 shrink-0 rounded-lg overflow-hidden flex items-center justify-center ring-1 ring-slate/10 transition-opacity duration-200 hover:opacity-75"
          >
            <img
              src={item.logoUrl}
              alt={`${item.company} logo`}
              class="w-full h-full object-contain"
              loading="lazy"
              onerror="this.style.display='none';this.nextElementSibling.style.display='flex'"
            />
            <span style="display:none" class="w-full h-full bg-accent/10 text-accent font-mono text-xs font-bold items-center justify-center rounded-lg">
              {item.company.split(' ').map(w => w[0]).slice(0, 3).join('')}
            </span>
          </a>

          <div class="flex-1 min-w-0">
            <div class="text-sm font-semibold text-maintext">{item.title}</div>
            <a
              href={item.companyUrl}
              class="subtle-link text-sm"
              target="_blank"
              rel="noreferrer"
            >
              {item.company}
            </a>
          </div>

          <div class="flex items-center gap-3 shrink-0">
            <span class="hidden sm:block font-mono text-xs text-subtext">{item.period}</span>
            <Icon name="ph:caret-down" class="accordion-chevron h-4 w-4 text-accent shrink-0 transition-transform duration-300" />
          </div>
        </button>

        <div
          id={`exp-body-${i}`}
          class="accordion-body grid"
          style="grid-template-rows: 0fr"
        >
          <div class="overflow-hidden">
            <div class="pt-4 pb-1 space-y-3">
              <div class="flex flex-wrap items-center gap-x-4 gap-y-1 font-mono text-xs text-subtext">
                <span class="sm:hidden">{item.period}</span>
                <span class="flex items-center gap-1 text-accent">
                  <Icon name="ph:map-pin" class="h-3.5 w-3.5" />
                  {item.location}
                </span>
              </div>
              <div class="border-t border-accent/10" />
              <ul class="space-y-1.5">
                {item.highlights.map(point => (
                  <li class="flex gap-2.5 text-sm text-maintext">
                    <span class="text-accent/50 mt-0.5 shrink-0 font-mono text-xs leading-5 select-none">→</span>
                    <span class="leading-relaxed">
                      {parseHighlight(point).map(seg => (
                        seg.type === 'link'
                          ? <a href={seg.href} target="_blank" rel="noreferrer" class="subtle-link">{seg.value}</a>
                          : seg.value
                      ))}
                    </span>
                  </li>
                ))}
              </ul>
              <ul class="flex flex-wrap gap-2 pt-1">
                {item.tech.map(tech => (
                  <li class="font-mono text-xs text-accent bg-accent/5 border border-accent/20 rounded px-2 py-0.5">
                    {tech}
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </article>
    ))}
  </div>
</section>

<style>
  .scroll-stat {
    opacity: 0;
    transform: translateY(20px) scale(0.95);
    transition: all 0.6s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .scroll-stat.reveal {
    opacity: 1;
    transform: translateY(0) scale(1);
  }

  .accordion-body {
    transition: grid-template-rows 0.4s cubic-bezier(0.16, 1, 0.3, 1);
  }
</style>

<script>
  function initAccordions() {
    document.querySelectorAll('.accordion-trigger').forEach((trigger) => {
      trigger.addEventListener('click', (e) => {
        if (e.target instanceof Element && e.target.closest('a')) return;
        const controlsId = trigger.getAttribute('aria-controls');
        const body = controlsId ? document.getElementById(controlsId) : null;
        const chevron = trigger.querySelector('.accordion-chevron');
        if (!body) return;
        const isOpen = body.style.gridTemplateRows === '1fr';
        body.style.gridTemplateRows = isOpen ? '0fr' : '1fr';
        if (chevron instanceof HTMLElement) chevron.style.transform = isOpen ? '' : 'rotate(180deg)';
        trigger.setAttribute('aria-expanded', String(!isOpen));
      });
    });
  }

  function revealCards() {
    const cards = document.querySelectorAll('.scroll-stat');
    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const index = Array.from(cards).indexOf(entry.target);
            setTimeout(() => entry.target.classList.add('reveal'), (index % 3) * 150);
            observer.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.15, rootMargin: '0px 0px -10px 0px' }
    );
    cards.forEach((card) => observer.observe(card));
  }

  initAccordions();
  revealCards();
  document.addEventListener('astro:after-swap', () => {
    initAccordions();
    revealCards();
  });
</script>
